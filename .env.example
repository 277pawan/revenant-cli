# Copy this file to .env in the project root, then fill in your own values.
# revenant verify loads .env automatically (via godotenv) if the file exists.
#
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
#
# Local Ubuntu default often looks like:
#   postgres://pawan-bisht@localhost:5432/revenant_demo?sslmode=disable
# If that fails with "peer authentication", create a password for your role
# (see README) and use:
DATABASE_URL=postgres://postgres:root@localhost:5432/revenant_demo?sslmode=disable
